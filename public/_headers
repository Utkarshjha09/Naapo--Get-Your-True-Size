/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# logos, photos and the icon keep their names, so cache them for a week and refresh quietly after that
/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
